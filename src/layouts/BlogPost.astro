---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagList from '../components/TagList.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  image?: string;
  minutes?: number;
  tags?: string[];
  related?: { id: string; title: string; description: string; shared: string[] }[];
  discussion?: number;
}
const { title, description, pubDate, updatedDate, image, minutes, tags = [], related = [], discussion } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={title} description={description} image={image} pubDate={pubDate}>
  <article class="post">
    <header class="post-header">
      <h1>{title}</h1>
      <p class="meta">
        <FormattedDate date={pubDate} />
        {updatedDate && <span> · updated <FormattedDate date={updatedDate} /></span>}
        {minutes && <span> · {minutes} min read</span>}
      </p>
      <TagList tags={tags} />
    </header>
    <div class="prose">
      <slot />
    </div>
    {related.length > 0 && (
      <aside class="related" aria-label="Related posts">
        <h2>Related posts</h2>
        <ul>
          {related.map((p) => (
            <li>
              <a href={`${base}${p.id}/`}>{p.title}</a>
              <span class="shared">{p.shared.map((t) => `#${t}`).join(' ')}</span>
            </li>
          ))}
        </ul>
      </aside>
    )}
    {discussion && (
      <section class="comments" aria-label="Comments">
        <h2>Comments</h2>
        <p class="comments-note">Comments are a <a href={`https://github.com/intigraph/community/discussions/${discussion}`}>GitHub Discussion</a>. Sign in with GitHub to reply here, or reply there.</p>
        <div class="giscus"></div>
        <script is:inline
          src="https://giscus.app/client.js"
          data-repo="intigraph/community"
          data-repo-id="R_kgDOVjOF_A"
          data-category="General"
          data-category-id="DIC_kwDOVjOF_M4DKZpy"
          data-mapping="number"
          data-term={String(discussion)}
          data-strict="1"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme="preferred_color_scheme"
          data-lang="en"
          data-loading="lazy"
          crossorigin="anonymous"
          async></script>
        <script is:inline>
          (function () {
            function theme() { return document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light'; }
            function send() {
              var f = document.querySelector('iframe.giscus-frame');
              if (f) f.contentWindow.postMessage({ giscus: { setConfig: { theme: theme() } } }, 'https://giscus.app');
            }
            window.addEventListener('message', function (e) { if (e.origin === 'https://giscus.app') send(); }, { once: true });
            new MutationObserver(send).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
          })();
        </script>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .post-header { margin: 1.5rem 0 2rem; }
  h1 { font-size: clamp(1.8rem, 1.3rem + 2.2vw, 2.6rem); line-height: 1.12; letter-spacing: -0.025em; }
  .meta { margin-top: 0.75rem; font-family: var(--font-ui); font-size: 0.8rem; color: var(--color-text-muted); }
  .related { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); }
  .related h2 { font-size: 1.1rem; margin-bottom: 0.75rem; }
  .related ul { list-style: none; padding: 0; }
  .related li + li { margin-top: 0.6rem; }
  .related a { font-family: var(--font-ui); font-weight: 600; text-decoration: none; }
  .shared { display: block; font-family: var(--font-ui); font-size: 0.72rem; color: var(--color-text-muted); margin-top: 0.15rem; }
  .comments { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); }
  .comments h2 { font-size: 1.1rem; margin-bottom: 0.5rem; }
  .comments-note { font-family: var(--font-ui); font-size: 0.8rem; color: var(--color-text-muted); margin-bottom: 1rem; }
</style>
