---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const posts = await getCollection('blog', ({ data }) => !data.draft);
const counts = new Map();
for (const p of posts) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Tags · Steve Brown" description="All tags">
  <h1>Tags</h1>
  <ul class="cloud">
    {tags.map(([t, n]) => <li><a href={`${base}tags/${t}/`}>#{t}</a> <span>{n}</span></li>)}
  </ul>
</BaseLayout>
<style>
  h1 { font-size: 2rem; margin: 1.5rem 0 1.5rem; }
  .cloud { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .cloud a { font-family: var(--font-ui); font-weight: 600; text-decoration: none; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 999px; padding: 0.25rem 0.75rem; }
  .cloud span { font-family: var(--font-ui); font-size: 0.75rem; color: var(--color-text-muted); }
</style>
